# Minimal Makefile to test RISC-V toolchain for CH572

PROJECT = test_minimal
BUILD_DIR = build_test

# SDK paths
SDK_ROOT = ../../..
STDPERIPH_DIR = $(SDK_ROOT)/EXAM/SRC/StdPeriphDriver
RVMSIS_DIR = $(SDK_ROOT)/EXAM/SRC/RVMSIS

# Toolchain detection
TOOLCHAIN_PREFIXES = riscv-none-embed- riscv64-unknown-elf- riscv-none-elf- riscv32-unknown-elf-

PREFIX := $(shell \
    for prefix in $(TOOLCHAIN_PREFIXES); do \
        if command -v $${prefix}gcc >/dev/null 2>&1; then \
            echo $$prefix; \
            break; \
        fi; \
    done)

ifeq ($(PREFIX),)
    PREFIX = riscv-none-embed-
    $(warning WARNING: RISC-V toolchain not detected, using default: $(PREFIX))
endif

CC = $(PREFIX)gcc
CP = $(PREFIX)objcopy
SZ = $(PREFIX)size

# CPU settings
ARCH = -march=rv32imac_zicsr_zifencei
ABI = -mabi=ilp32
MCU = $(ARCH) $(ABI) -msmall-data-limit=8 -mno-save-restore

# Defines
C_DEFS = -DCH572 -DCHIP_ID=ID_CH572

# Includes
C_INCLUDES = \
-I$(STDPERIPH_DIR)/inc \
-I$(RVMSIS_DIR)

# Compiler flags
CFLAGS = $(MCU) $(C_DEFS) $(C_INCLUDES) -Os -Wall -fdata-sections -ffunction-sections

# Linker script
LDSCRIPT = Link_FoodLabel.ld

# Libraries
LIBS = -L$(STDPERIPH_DIR) -lISP572 -lc -lm -lnosys

# Linker flags
LDFLAGS = $(MCU) -specs=nano.specs -T$(LDSCRIPT) $(LIBS) -Wl,-Map=$(BUILD_DIR)/$(PROJECT).map,--cref -Wl,--gc-sections

# Source files
C_SOURCES = \
test_minimal.c \
$(STDPERIPH_DIR)/CH57x_sys.c

ASM_SOURCES = \
$(SDK_ROOT)/EXAM/SRC/Startup/startup_CH572.S

# Objects
OBJECTS = $(addprefix $(BUILD_DIR)/,$(notdir $(C_SOURCES:.c=.o)))
vpath %.c $(sort $(dir $(C_SOURCES)))

OBJECTS += $(addprefix $(BUILD_DIR)/,$(notdir $(ASM_SOURCES:.S=.o)))
vpath %.S $(sort $(dir $(ASM_SOURCES)))

# Build rules
all: $(BUILD_DIR)/$(PROJECT).elf
	@echo ""
	@echo "✅ Build successful!"
	@echo ""

$(BUILD_DIR)/%.o: %.c | $(BUILD_DIR)
	@echo "CC $<"
	@$(CC) -c $(CFLAGS) $< -o $@

$(BUILD_DIR)/%.o: %.S | $(BUILD_DIR)
	@echo "AS $<"
	@$(CC) -c $(CFLAGS) $< -o $@

$(BUILD_DIR)/$(PROJECT).elf: $(OBJECTS)
	@echo "LD $@"
	@$(CC) $(OBJECTS) $(LDFLAGS) -o $@
	@$(SZ) $@

$(BUILD_DIR):
	mkdir -p $@

clean:
	rm -rf $(BUILD_DIR)

.PHONY: all clean
